# SK Baghel Tour & Travels — Customer site security & cache headers

# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite emits content-hashed filenames — safe to cache for 1 year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must always revalidate so visitors pick up re-deploys instantly.
/*.html
  Cache-Control: no-cache, must-revalidate

# Sitemap and robots.txt — short TTL so search engines get fresh copies.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# H1 (Network & Transport): Early Hints fuel. Preload the homepage LCP image —
# this href must match the HeroBentoGrid fetchPriority="high" <img src> exactly
# (no srcset in markup yet) so the preload is reused, not double-downloaded.
# Cloudflare turns these Link headers into 103 Early Hints once the toggle is ON.
# Ownership passes to H7 (SmartImage/AVIF) — update these hrefs when markup changes.
/
  Link: </assets/packages/taj-dawn.webp>; rel=preload; as=image; fetchpriority=high
/en/
  Link: </assets/packages/taj-dawn.webp>; rel=preload; as=image; fetchpriority=high
/hi/
  Link: </assets/packages/taj-dawn.webp>; rel=preload; as=image; fetchpriority=high
