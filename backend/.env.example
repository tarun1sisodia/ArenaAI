NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
FARE_RULES_VERSION=2026-09-13

# Comma-separated extra CORS origins (local Vite is always allowed).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://skbagheltravels.in

# Set true only in local/test. Never enable in production.
ALLOW_TEST_AUTH=false

# PostgreSQL / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional MongoDB (cache / raw webhooks only — never the ledger)
MONGODB_URI=

# Razorpay (India). Test keys only until webhook drills pass.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# International card processor (adapter-shaped; HMAC webhook)
CARD_PROVIDER_SECRET=
CARD_WEBHOOK_SECRET=
CARD_CHECKOUT_BASE_URL=https://checkout.example-cards.test

# LocationIQ — server-held only
LOCATIONIQ_TOKEN=

# Notifications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PAYMENT=skb_payment_confirmed
RESEND_API_KEY=
EMAIL_FROM=bookings@skbagheltravels.in

# Sandbox FX table used only when creating non-INR checkouts from an INR advance.
FX_USD_PER_INR=0.012
FX_EUR_PER_INR=0.011
FX_GBP_PER_INR=0.0095
