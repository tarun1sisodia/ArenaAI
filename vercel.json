{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run customer:build",
  "outputDirectory": "react/dist",
  "installCommand": "npm ci && npm ci --prefix react",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
