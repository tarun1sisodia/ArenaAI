# Customer and admin frontend API origin.
# Use the production API hostname in Cloudflare Pages variables.
VITE_API_BASE_URL=https://api.skbagheltravels.in

# React migration gate. Keep false until the React platform is approved for cutover.
VITE_REACT_MIGRATION_ENABLED=false

# Optional deployment-injected LocationIQ public browser token.
# Never commit a real token to this file or source control.
# VITE_LOCATIONIQ_ACCESS_TOKEN=
