@@ -48,9 +58,14 @@ SKB.calcFare = ({ routeId, from, to, vehicleId, tripType = "one-way", packageId
   if (!route || !vehicle) return null;
   let total = route.fares[vehicle.id];
   if (total == null) return null;
+  let roundMultiplier = false;
